# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Toda la configuracion de la app se lee de estas variables: no hay URLs,
# nombres de bucket ni claves escritas en el codigo.

# --- API de Lumon ---
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# --- Storage de imagenes (CP4): Supabase Storage ---
# Solo la clave PUBLICABLE (sb_publishable_... o el JWT anon).
# La service_role key NUNCA va en el frontend: deja el CP4 y el CP6 en 0.
VITE_STORAGE_PROVIDER=SUPABASE
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_BUCKET=lumon-media

# Codigo de la cuadrilla, usado como prefijo de carpeta en el storage.
VITE_TEAM_CODE=
